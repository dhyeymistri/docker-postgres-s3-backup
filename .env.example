# Database Credentials
PGHOST=postgres
PGPORT=5432
PGDATABASE=app_db
PGUSER=postgres
PGPASSWORD=replace_with_strong_password

# Object Storage (AWS S3, Cloudflare R2, MinIO, Wasabi)
# For R2: scope the API token to this bucket only, not full account access.
S3_BUCKET=my-app-backups
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Schedule & Lifecycle (standard 5-field cron syntax)
BACKUP_CRON=0 2 * * *
RETENTION_DAYS=7
